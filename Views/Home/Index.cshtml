@{
    ViewData["Title"] = "Home";
}

<!-- ═══════════════════════════════════════════
     HERO SECTION
═══════════════════════════════════════════ -->
<section id="home" class="hero-section">
    <div class="hero-overlay"></div>
    @if (TempData["Success"] != null)
    {
        <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
        </div>
    }

    <script>
            setTimeout(function () {
                const alertBox = document.getElementById("successAlert");
                if (alertBox) {
                    alertBox.remove();
                }
            }, 3000);
    </script>
    <div class="container position-relative z-1">
        <div class="row min-vh-hero align-items-center">
            <div class="col-lg-8">
                <span class="hero-pill">Sports Creative Agency</span>
                <h1 class="hero-title mt-3">
                    Crafted<br />for <span class="hero-accent">Growth.</span>
                </h1>
                <p class="hero-sub mt-4">
                    Helping clubs, academies, athletes, and sports brands<br class="d-none d-lg-block" />
                    build a strong and recognizable digital presence.
                </p>
                <div class="mt-5 d-flex gap-3 flex-wrap">
                    <a href="#about" class="btn btn-cta btn-lg-cta">Discover More</a>
                    <a href="#pricing" class="btn btn-ghost-cta btn-lg-cta">View Packages</a>
                </div>
            </div>
        </div>
   
        <div class="hero-scroll-hint">
            <a href="#about" aria-label="Scroll down"><i class="fas fa-chevron-down"></i></a>
        </div>
    </div>

    <!-- Decorative ticker -->
    <div class="hero-ticker">
        <div class="ticker-track">
            <span>Social Media Management</span><span class="ticker-dot">✦</span>
            <span>Reels & Creative Design</span><span class="ticker-dot">✦</span>
            <span>Matchday Content</span><span class="ticker-dot">✦</span>
            <span>Sports Branding</span><span class="ticker-dot">✦</span>
            <span>Photography & Shoots</span><span class="ticker-dot">✦</span>
            <span>Performance Marketing</span><span class="ticker-dot">✦</span>
            <span>Social Media Management</span><span class="ticker-dot">✦</span>
            <span>Reels & Creative Design</span><span class="ticker-dot">✦</span>
            <span>Matchday Content</span><span class="ticker-dot">✦</span>
            <span>Sports Branding</span><span class="ticker-dot">✦</span>
            <span>Photography & Shoots</span><span class="ticker-dot">✦</span>
            <span>Performance Marketing</span><span class="ticker-dot">✦</span>
        </div>
    </div>
</section>


<!-- ═══════════════════════════════════════════
     ABOUT SECTION
═══════════════════════════════════════════ -->
<section id="about" class="about-section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5">
                <div class="about-media-box">
                    <div class="about-badge-float">Sports-Focused Agency</div>
                    <!-- Replace with actual image: <img src="~/images/about.jpg" class="about-img" alt="About Cinellex Media" /> -->
                    <div class="about-img-placeholder">
                        <i class="fas fa-futbol fa-4x"></i>
                        <p class="mt-3">Your brand image here</p>
                    </div>
                    <div class="about-stat-float">
                        <span class="stat-big">2026</span>
                        <span class="stat-small">Established</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <span class="section-eyebrow">About Us</span>
                <h2 class="section-heading mt-2">
                    We don't just manage pages.<br />
                    We build <span class="text-accent">digital identity.</span>
                </h2>
                <p class="section-body mt-4">
                    Founded by <strong>Uttkarsh Chavan</strong> and co-founded by <strong>Sunny Nikhade</strong>,
                    Cinellex Media is a sports-focused creative agency helping clubs, academies, athletes, and
                    sports brands build a strong digital presence.
                </p>
                <p class="section-body mt-3">
                    Combining sports management expertise with visual storytelling, we create authentic and
                    impactful content through social media management, creative design, reels, matchday
                    coverage, photography, and branding.
                </p>
                <div class="about-highlights mt-4">
                    <div class="highlight-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Sports management expertise</span>
                    </div>
                    <div class="highlight-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Authentic visual storytelling</span>
                    </div>
                    <div class="highlight-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Community-first approach</span>
                    </div>
                    <div class="highlight-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Trend-driven content strategy</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ═══════════════════════════════════════════
     SERVICES SECTION
═══════════════════════════════════════════ -->
<section id="services" class="services-section">
    <div class="container">
        <div class="section-header text-center mb-5">
            <span class="section-eyebrow">What We Do</span>
            <h2 class="section-heading mt-2">Our Services</h2>
            <p class="section-sub">Everything your sports brand needs to dominate online.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon-wrap"><i class="fas fa-mobile-alt"></i></div>
                    <h5 class="service-title">Social Media Management</h5>
                    <p class="service-desc">Full management of your club or athlete's social pages with consistent, engaging content.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon-wrap"><i class="fas fa-lightbulb"></i></div>
                    <h5 class="service-title">Content Strategy</h5>
                    <p class="service-desc">Data-driven content calendars and engagement strategies tailored to your audience.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="service-card service-card-featured">
                    <div class="service-icon-wrap"><i class="fas fa-film"></i></div>
                    <h5 class="service-title">Reels & Creative Design</h5>
                    <p class="service-desc">High-impact reels, carousels, and graphics crafted to stop the scroll and drive reach.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon-wrap"><i class="fas fa-futbol"></i></div>
                    <h5 class="service-title">Matchday Content</h5>
                    <p class="service-desc">Live matchday graphics, post-match recaps, and real-time social coverage.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon-wrap"><i class="fas fa-camera"></i></div>
                    <h5 class="service-title">Photography & Shoots</h5>
                    <p class="service-desc">Professional sports photography and creative shoots for clubs, athletes, and brands.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon-wrap"><i class="fas fa-bullseye"></i></div>
                    <h5 class="service-title">Performance Marketing</h5>
                    <p class="service-desc">Paid campaigns and growth strategies to expand reach and attract new audiences.</p>
                </div>
            </div>
        </div>
    </div>
</section>


