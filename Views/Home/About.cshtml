@{
    ViewData["Title"] = "About Us";
}

<div class="container py-1">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            
            <!-- Hero Section -->
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold text-dark">About Us</h1>
                <p class="lead text-muted">Discover who we are and what drives us</p>
                <hr class="w-25 mx-auto border-3 border-primary" />
            </div>

            <!-- Story Section -->
            <div class="row align-items-center mb-5">
                <div class="col-lg-6">
                    <h2 class="fw-bold mb-4">Our Story</h2>
                    <p class="lead">
                        Founded in 2020, we started with a simple mission: to deliver exceptional quality
                        and innovative solutions that make a real difference in people's lives.
                    </p>
                    <p>
                        What began as a small team of passionate individuals has grown into a trusted
                        company serving hundreds of satisfied customers across the country.
                        Our journey has been shaped by dedication, creativity, and an unwavering
                        commitment to excellence.
                    </p>
                </div>
                <div class="col-lg-6 text-center">
                    <img src="~/images/profile.jpg"
                         alt="Our Team"
                         class="img-fluid rounded shadow"
                         style="max-height: 380px; object-fit: cover;" />
                </div>
            </div>

            <!-- Mission & Vision -->
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h4 class="fw-bold text-primary mb-3">
                                <i class="fas fa-bullseye me-2"></i> Our Mission
                            </h4>
                            <p class="text-muted">
                                To provide high-quality services and solutions that exceed customer expectations
                                while maintaining the highest standards of integrity and innovation.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h4 class="fw-bold text-primary mb-3">
                                <i class="fas fa-eye me-2"></i> Our Vision
                            </h4>
                            <p class="text-muted">
                                To become a leading name in our industry, recognized for excellence,
                                creativity, and positive impact on society and the environment.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Values Section -->
            <h2 class="fw-bold text-center mb-4">Our Core Values</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="text-center p-4">
                        <i class="fas fa-heart fa-3x text-danger mb-3"></i>
                        <h5 class="fw-bold">Passion</h5>
                        <p class="text-muted small">We pour our heart into every project we undertake.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center p-4">
                        <i class="fas fa-handshake fa-3x text-success mb-3"></i>
                        <h5 class="fw-bold">Integrity</h5>
                        <p class="text-muted small">We believe in honesty, transparency, and ethical practices.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center p-4">
                        <i class="fas fa-lightbulb fa-3x text-warning mb-3"></i>
                        <h5 class="fw-bold">Innovation</h5>
                        <p class="text-muted small">We continuously seek new and better ways to serve our clients.</p>
                    </div>
                </div>
            </div>

            <!-- Team / Why Choose Us -->
            <div class="mt-5 pt-5 border-top">
                <h2 class="fw-bold text-center mb-4">Why Choose Us?</h2>
                <div class="row text-center">
                    <div class="col-md-4 mb-4">
                        <h3 class="display-6 fw-bold text-primary">100+</h3>
                        <p class="fw-bold">Happy Clients</p>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h3 class="display-6 fw-bold text-primary">50+</h3>
                        <p class="fw-bold">Projects Completed</p>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h3 class="display-6 fw-bold text-primary">6</h3>
                        <p class="fw-bold">Years Experience</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>