<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Your Company Name</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- HEADER / NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logos.png" alt="Company Logo" style="height: 60px;" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-start">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Gallery" asp-action="Index">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="About">About</a>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <div class="container flex-grow-1 py-4">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="text-dark" style="background-color: #ECEFF1;">
        
        <!-- Links section -->
        <section class="py-4">
            <div class="container text-center text-md-start">
                <div class="row">

                    <!-- Company Info -->
                    <div class="col-md-3 col-lg-4 col-xl-3 mx-auto mb-4">
                        <h6 class="text-uppercase fw-bold">Cinellex Media</h6>
                        <hr class="mb-2 mt-0 d-inline-block mx-auto" style="width: 60px; background-color: #7c4dff; height: 2px;" />
                        <p class="text-muted small">Visuals that captivate. Content that converts..</p>
                    </div>

                    <!-- Products -->
                    <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mb-4">
                        <h6 class="text-uppercase fw-bold">Products</h6>
                        <hr class="mb-2 mt-0 d-inline-block mx-auto" style="width: 60px; background-color: #7c4dff; height: 2px;" />
                        <p class="mb-1 small"><a href="#" class="text-dark text-decoration-none">MDBootstrap</a></p>
                        <p class="mb-1 small"><a href="#" class="text-dark text-decoration-none">MDWordPress</a></p>
                        <p class="mb-1 small"><a href="#" class="text-dark text-decoration-none">BrandFlow</a></p>
                        <p class="mb-1 small"><a href="#" class="text-dark text-decoration-none">Bootstrap Angular</a></p>
                    </div>

                    <!-- Useful Links -->
                    <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mb-4">
                        <h6 class="text-uppercase fw-bold">Useful Links</h6>
                        <hr class="mb-2 mt-0 d-inline-block mx-auto" style="width: 60px; background-color: #7c4dff; height: 2px;" />
                        <p class="mb-1 small"><a href="#" class="text-dark text-decoration-none">Your Account</a></p>
                        <p class="mb-1 small"><a href="#" class="text-dark text-decoration-none">Become an Affiliate</a></p>
                        <p class="mb-1 small"><a href="#" class="text-dark text-decoration-none">Shipping Rates</a></p>
                        <p class="mb-1 small"><a href="#" class="text-dark text-decoration-none">Help</a></p>
                    </div>

                    <!-- Contact -->
                    <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mb-4">
                        <h6 class="text-uppercase fw-bold">Contact</h6>
                        <hr class="mb-2 mt-0 d-inline-block mx-auto" style="width: 60px; background-color: #7c4dff; height: 2px;" />
                        <p class="mb-1 small"><i class="fas fa-home me-2"></i> New York, NY 10012, US</p>
                        <p class="mb-1 small"><i class="fas fa-envelope me-2"></i> info@example.com</p>
                        <p class="mb-1 small"><i class="fas fa-phone me-2"></i> +01 234 567 88</p>
                        <p class="mb-1 small"><i class="fas fa-print me-2"></i> +01 234 567 89</p>
                    </div>

                </div>
            </div>
        </section>

        <!-- Copyright + Social Icons -->
        <div class="d-flex justify-content-between align-items-center px-4 py-3 text-white"
             style="background-color: #21D192; font-size: 16px;">
            <span>© 2026 Copyright: <a href="#" class="text-white text-decoration-none"><bold>Cinellex Media</bold></a></span>
            
            <div class="social-icons">
                <a href="#" class="me-3">
                    <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/facebook.svg" width="20" height="20" />
                </a>
                <a href="#" class="me-3">
                    <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/twitter.svg" width="20" height="20" />
                </a>
                <a href="#" class="me-3">
                    <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/google.svg" width="20" height="20" />
                </a>
                <a href="#" class="me-3">
                    <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/instagram.svg" width="20" height="20" />
                </a>
                <a href="https://www.linkedin.com/company/113120897" class="me-3">
                    <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/linkedin.svg" width="20" height="20" />
                </a>
                <a href="#" class="me-3">
                    <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/github.svg" width="20" height="20" />
                </a>
            </div>
        </div>

    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>