<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinellex Media</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg bg-black sticky-top" id="mainNav">
            <div class="container-fluid px-4">

                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/IMG_0251-removebg-preview (1).png" alt="Cinellex Media" />
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-label="Toggle navigation">
                    <i class="fas fa-bars text-white"></i>
                </button>

                <div class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav gap-1 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" href="#home">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#about">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#services">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#clients">Clients</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#gallery">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#process">Process</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#pricing">Investment</a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-cta" href="#contact">Get In Touch</a>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer-section">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <img src="~/images/IMG_0251-removebg-preview (1).png" alt="Cinellex Media" style="height:200px;" class="mb-3" />
                    <p class="footer-tagline">Crafted for Growth.</p>
                    <p class="footer-sub">Sports-focused creative agency helping clubs, academies, athletes, and sports brands build a strong digital presence.</p>
                    <p class="footer-est">ESTD 1 January 2026</p>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="footer-heading">Navigate</h6>
                    <ul class="footer-links">
                        <li><a href="#home">Home</a></li>
                        <li><a href="#about">About</a></li>
                        <li><a href="#services">Services</a></li>
                        <li><a href="#clients">Clients</a></li>
                        <li><a href="#pricing">Investment</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-6">
                    <h6 class="footer-heading">Services</h6>
                    <ul class="footer-links">
                        <li><a href="#services">Social Media Management</a></li>
                        <li><a href="#services">Reels & Creative Design</a></li>
                        <li><a href="#services">Matchday Content</a></li>
                        <li><a href="#services">Branding</a></li>
                        <li><a href="#services">Photography & Shoots</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="footer-heading">Contact</h6>
                    <p class="footer-contact"><i class="fas fa-envelope me-2"></i>cinellexmedia.co@gmail.com</p>
                    <p class="footer-contact"><i class="fab fa-instagram me-2"></i>cinellexmedia</p>
                    <div class="social-row mt-3">
                        <a href="https://instagram.com/cinellexmedia" class="social-icon" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="https://www.linkedin.com/company/113120897" class="social-icon" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                        <a href="mailto:cinellexmedia.co@gmail.com" class="social-icon" aria-label="Email"><i class="fas fa-envelope"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>© 2026 Cinellex Media. All rights reserved.</span>
                <span>Founded by <strong>Uttkarsh Chavan</strong> & <strong>Sunny Nikhade</strong></span>
                <span><strong>Developer: Shreyas Chavare</strong></span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
